# build artifacts
/target
**/*.rs.bk

# rr traces are evidence, not source — they move via artifact upload, not git
rr-traces/

# python
__pycache__/
*.pyc

# web
node_modules/
dist/
.DS_Store
**/.DS_Store
pkg/

# E0-T23 browser demo build artifacts (regenerated by 'make web-build')
web/node_modules/
web/pkg/
web/assets/*.elf
web/assets/riscv-tests/

# poor-mans-ci: web/dist is the deployable site, BUILT LOCALLY by the pre-commit hook and COMMITTED
# so CI only deploys (no CI build). Track it despite the broad dist/ & pkg/ ignores above; but the
# large boot artifacts (kernel Image + initramfs) are copied in from releases/ at deploy time, so
# keep web/dist/releases/ out of git (no ~22 MB kernel duplicated per web change).
!web/dist/
!web/dist/**
web/dist/releases/
.claude/worktrees/
.DS_Store
**/.DS_Store

# E1-T20 RISCOF (provisioned by compliance/provision.sh; not vendored)
compliance/.venv/
compliance/riscv-arch-test/
compliance/riscof_work/
compliance/config.ini

# E1-T21 differential fuzzer scratch (generated .S/.elf per run)
tools/fuzz/.work/

# E1-T26 Sail reference model (downloaded by provision.sh; not vendored)
compliance/sail-riscv/

# E2-T18: the Alpine rootfs ext4 is 512 MiB (sparse ~10 MiB actual) — reproducible from
# `bash tools/build-rootfs.sh` and pinned by releases/rootfs/MANIFEST.txt (package-level; see build-rootfs.sh drift gate), so it's not tracked.
releases/rootfs/*.ext4
releases/rootfs/MANIFEST.new
releases/rootfs/FILE-MANIFEST.new
releases/wvft-agent-riscv64

# Playwright test artifacts (E2-T21)
web/test-results/
web/playwright-report/

# Boot artifacts copied under web/ for Pages deploy (source of truth is releases/)
web/releases/

# E2-T24 stress-run artifacts (per-run images, logs, summary)
tests/stress/out/

# E2-T26 local-only Alpine capstone manifest (generated by tools/demo-capstone.sh; not gh-pages)
web/artifacts-alpine.json

# E3-T02 local-only chunked Alpine image (built by `wasm-vm chunk`; derived from the ext4)
releases/chunked-alpine/

releases/wvseccomp-riscv64

# Container bundles baked into the Alpine rootfs (rebuild: tools/build-container-bundle.sh <img>).
# 82M of pulled/unpacked images — rebuildable, like releases/rootfs; not committed.
releases/container-bundles/

# E4-T04 in-guest gcc compile-benchmark overlay (~130 MB gcc+musl-dev+binutils; rebuild:
# bench/mk-gcc-image.sh). Durable committed artifacts are the builder + bench/guest/gcc-MANIFEST.txt
# (pinned resolved package set + overlay sha256) + the vendored miniz sources — not the overlay.
bench/guest/gcc.ext4
bench/guest/gcc-MANIFEST.new

# Agent/session scratch (Claude Code runtime, Playwright MCP output)
.claude/
.agents/
.playwright-mcp/
