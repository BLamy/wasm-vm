# E4-T03 benchmark toolchain — pinned versions. Sourced by build.sh and the Dockerfile.
# Mirrors tools/toolchain/versions.env, but installs the riscv64-LINUX GLIBC cross-gcc
# (Linux ABI: clock_gettime/times/write) instead of the bare-metal newlib toolchain — the
# CoreMark/Dhrystone ELFs are statically-linked Linux userspace binaries the guest kernel execs.
#
# The pinned CoreMark/Dhrystone score is only meaningful against these EXACT versions — a
# compiler bump silently changes the workload's codegen. Bump deliberately, never implicitly.

# Base image, pinned by digest (never `latest`). Same Ubuntu 24.04 (noble) digest the reference
# toolchain uses (tools/toolchain/versions.env), so both images share one apt snapshot in spirit.
UBUNTU_DIGEST="ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90"

# Build on amd64 REGARDLESS of host arch (this repo is developed on arm64 macs). Pinning the
# build platform is part of byte-identical reproducibility — the emitted ELF must not depend on
# whether the invoking host is arm64 or amd64. amd64 runs under emulation on Apple silicon.
BUILD_PLATFORM="linux/amd64"

# apt package versions in Ubuntu 24.04 (exact, from `apt-cache policy`). We pin the CONCRETE
# gcc-13 cross package (the metapackage gcc-riscv64-linux-gnu just depends on it) plus the static
# glibc dev files. DURABILITY: these pins resolve against Ubuntu's LIVE archive, which prunes
# superseded versions; if Ubuntu supersedes one the build HARD-FAILS at `apt-get install pkg=ver`
# (fail-loud, never silent drift). The committed ELFs + SHA256SUMS are the durable artifact — the
# image is how you REPRODUCE them, and AC4 (byte-identical rebuild) holds only while these resolve.
GCC_RISCV64_LINUX_VERSION="13.3.0-6ubuntu2~24.04.1cross1"   # gcc-13-riscv64-linux-gnu
LIBC6_DEV_RISCV64_VERSION="2.39-0ubuntu8cross1"            # libc6-dev-riscv64-cross (static glibc)

# The tag build.sh produces.
IMAGE_TAG="wasm-vm-bench-toolchain:local"
