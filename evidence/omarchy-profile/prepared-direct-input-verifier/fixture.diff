+test("synthetic prepared-pair path reads saved settings once and preserves physical-only nonce/deadlines", async () => {
+  const f=fixture({preparedDirect:true}); assert.equal(await f.run(),null);
+  assert.equal(f.report.preparedDirect.status,"properties-confirmed");
+  assert.equal(f.report.result,"input-trial-physical-nonce-and-fresh-presentation");
+  const order=["saved-property-read","prepared-direct.png","key","input-fence","readback","desktop-keyboard.png"];
+  for(let i=1;i<order.length;i++) assert.ok(f.trace.indexOf(order[i-1])<f.trace.indexOf(order[i]));
+  assert.equal(f.commands.filter(command=>command===PREPARED_DIRECT_COMMAND).length,1);
+  assert.ok(!f.commands.includes(DIRECT_OPAQUE_COMMAND));
+  assert.equal(f.report.startup.timeoutMs,300000);
+  assert.equal(Date.parse(f.report.keyboard.deadlineAt),f.report.keyboard.enteredAtMs+120000);
+  for(const mutation of [{badOpaque:true},{lateReadback:true},{stalePresentation:true}]) {
+    const bad=fixture({preparedDirect:true,...mutation}); assert.ok(await bad.run());
+    assert.equal(bad.report.result,undefined);
+    if(mutation.badOpaque) assert.equal(bad.keys.length,0);
+  }
+});
