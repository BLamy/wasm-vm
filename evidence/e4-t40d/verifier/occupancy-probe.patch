+    /// VERIFIER SCRATCH (not in the repo): (live blocks, slots holding any block, total ops,
+    /// total ops capacity) so resident memory can be computed instead of inferred from RSS.
+    pub fn verifier_occupancy(&self) -> (usize, usize, usize, usize) {
+        let (mut live, mut held, mut ops, mut cap) = (0usize, 0usize, 0usize, 0usize);
+        for slot in &self.slots {
+            if let Some(block) = &slot.block {
+                held += 1;
+                ops += block.ops.len();
+                cap += block.ops.capacity();
+                if block.block_gen == self.generation {
+                    live += 1;
+                }
+            }
+        }
+        (live, held, ops, cap)
+    }
