{
  "argv": [
    "qemu-system-riscv64",
    "-machine",
    "virt",
    "-accel",
    "tcg",
    "-cpu",
    "rv64",
    "-smp",
    "4",
    "-m",
    "2048",
    "-global",
    "virtio-mmio.force-legacy=false",
    "-bios",
    "default",
    "-kernel",
    "/kernel/Image",
    "-append",
    "root=/dev/vda rw console=ttyS0 init=/bin/bash",
    "-drive",
    "file=/capture/final-corpus/textured-scene/overlay.qcow2,format=qcow2,if=none,id=root",
    "-device",
    "virtio-blk-device,drive=root",
    "-device",
    "virtio-gpu-gl-device",
    "-device",
    "virtio-keyboard-device",
    "-device",
    "virtio-tablet-device",
    "-fsdev",
    "local,id=capture,path=/capture,security_model=none",
    "-device",
    "virtio-9p-device,fsdev=capture,mount_tag=capture",
    "-display",
    "gtk,gl=on,show-cursor=on",
    "-serial",
    "unix:/capture/final-corpus/textured-scene/serial.sock,server=on,wait=on",
    "-monitor",
    "none",
    "-no-reboot"
  ],
  "env": {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/root",
    "LANG": "C.UTF-8",
    "MESA_SHADER_CACHE_DISABLE": "true",
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe",
    "LD_LIBRARY_PATH": "/build-virgl-1.3.0/src",
    "LD_PRELOAD": "/capture/recorder.so",
    "VIRGL_CAPTURE_REAL_LIBRARY": "/build-virgl-1.3.0/src/libvirglrenderer.so.1",
    "VIRGL_CAPTURE_DIR": "/capture/final-corpus/textured-scene",
    "VIRGL_CAPTURE_WORKLOAD": "textured-scene",
    "VIRGL_CAPTURE_MAX_EVENTS": "100000",
    "VIRGL_CAPTURE_MAX_BLOB_BYTES": "536870912",
    "VIRGL_CAPTURE_MAX_EVENT_BYTES": "67108864"
  },
  "guestScript": "guest.sh"
}
