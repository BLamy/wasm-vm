  8: MUL TEMP[8].xyz, TEMP[5].xyzz, TEMP[7].xxxx
  9: DP3 TEMP[9].x, TEMP[8].xyzx, IMM[0].xxyx
 10: MAX_PRECISE OUT[1].x, TEMP[9].xxxx, IMM[0].zzzz
 11: MUL TEMP[10], CONST[0], IN[0].xxxx
 12: MUL TEMP[11], CONST[1], IN[0].yyyy
 13: ADD TEMP[12], TEMP[10], TEMP[11]
 14: MUL TEMP[13], CONST[2], IN[0].zzzz
 15: ADD TEMP[14], TEMP[12], TEMP[13]
 16: ADD OUT[0], TEMP[14], CONST[3]
 17: MOV OUT[1].yz, IN[2].xxyx
 18: END
