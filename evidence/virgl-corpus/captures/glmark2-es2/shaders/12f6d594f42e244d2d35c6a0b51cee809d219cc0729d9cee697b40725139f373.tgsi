VERT
DCL IN[0]
DCL IN[1]
DCL IN[2]
DCL OUT[0], POSITION
DCL OUT[1].xyz, GENERIC[0]
DCL CONST[0..7]
DCL TEMP[0..14]
IMM[0] UINT32 {1059760811, 1051372203, 0, 0}
DCL TEMP[15..18]
  0: MUL TEMP[0].xyz, CONST[4].xyzz, IN[1].xxxx
  1: MUL TEMP[1].xyz, CONST[5].xyzz, IN[1].yyyy
  2: ADD TEMP[2].xyz, TEMP[0].xyzx, TEMP[1].xyzx
  3: MUL TEMP[3].xyz, CONST[6].xyzz, IN[1].zzzz
  4: ADD TEMP[4].xyz, TEMP[2].xyzx, TEMP[3].xyzx
  5: ADD TEMP[5].xyz, TEMP[4].xyzx, CONST[7].xyzz
