#!/bin/sh
# E5-T34b: PID-1 sysinit. Root is ext4 mounted read-only; all writable state is tmpfs.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
grep -q ' /dev ' /proc/mounts || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=1777 shm /dev/shm
for d in /run:755 /tmp:1777 /home:755 /var:755 /root:700; do
  mount -t tmpfs -o nosuid,nodev,mode=${d#*:} tmpfs ${d%:*}
done
mkdir -p -m 1777 /var/tmp
hostname -F /etc/hostname
ip link set lo up 2>/dev/null
mkdir -p /home/desktop /run/user/1000 /run/replay-desktop
chown 1000:1000 /home/desktop /run/user/1000 /run/replay-desktop
chmod 700 /run/user/1000
: > /run/replay-desktop/events
chown 1000:1000 /run/replay-desktop/events
# udevd tags the virtio keyboard/tablet/mouse (ID_INPUT_*) so libinput (sway) accepts them.
/usr/lib/systemd/systemd-udevd --daemon --resolve-names=never
udevadm trigger --action=add --subsystem-match=input --subsystem-match=drm
udevadm settle --timeout=60
# Replay Node 26 is cross-built without its built-in startup snapshot (the build cannot run a
# riscv64 mksnapshot), so every `node` start would run the whole JavaScript bootstrap: about
# 0.8 s of guest CPU against 0.3 s from a snapshot. Build one per boot into tmpfs, in the
# background at the lowest priority (about 4 s of guest CPU, in the gaps of the desktop's own
# start): it always matches the binary and the CPU it runs on, and a warm RAM snapshot of the
# desktop carries it. The /usr/local/bin/node wrapper uses it once it is there; the monitor
# reports it after REPLAY_DESKTOP_READY.
mkdir -p /run/replay-node
(
  # busybox here has renice but no nice: the inner shell lowers itself, then becomes node.
  sh -c 'renice 19 $$ >/dev/null 2>&1; export RECORD_REPLAY_DONT_RECORD=1
    exec /opt/replay-node-26/bin/node --snapshot-blob /run/replay-node/startup.blob.tmp --build-snapshot /dev/null' \
    >/run/replay-node/build.log 2>&1 </dev/null \
    && mv /run/replay-node/startup.blob.tmp /run/replay-node/startup.blob
  rm -f /run/replay-node/startup.blob.tmp
  : > /run/replay-node/done
) &
# Network (E5-T43c): eth0 by DHCP, in the background so nothing waits for it. udhcpc keeps the
# lease (and retries without one); its hook sets the address, the default route and
# /run/resolv.conf. With no DHCP server the desktop comes up exactly as before, offline.
ip link set lo up 2>/dev/null
if [ -d /sys/class/net/eth0 ]; then
  ip link set eth0 up 2>/dev/null
  udhcpc -f -i eth0 -s /usr/local/share/udhcpc/default.script >/run/udhcpc.log 2>&1 </dev/null &
fi
seatd -g video >/run/seatd.log 2>&1 &
i=0; while [ ! -S /run/seatd.sock ] && [ $i -lt 600 ]; do sleep 0.1; i=$((i+1)); done
su -s /bin/sh desktop -c /usr/local/bin/replay-desktop-session </dev/null >/run/session.log 2>&1 &
replay-desktop-monitor </dev/null >/dev/console 2>&1 &
