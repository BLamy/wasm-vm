#!/bin/sh
# E5-T18d: explicit kernel command-line opt-in, fixed diagnostic verbs, no shell or credential.
# Normal production boots immediately exec the original serial getty.
set -u
case " $(cat /proc/cmdline) " in
  *' wasmvm.desktop_test=1 '*) ;;
  *) exec /sbin/getty -L 115200 ttyS0 vt100 ;;
esac

state=/home/desktop/.local/state/wasm-vm
read_state() {
  # User-controlled paths never inherit root's read authority; reject special nodes and links.
  # The timeout also bounds a race that swaps a regular file for a FIFO after the type check.
  timeout -s KILL 2 runuser -u desktop -- /bin/sh -c '
    if [ -f "$1" ] && [ ! -L "$1" ]; then
      case "$2" in
        head) head -c "$3" "$1" ;;
        tail) tail -n "$3" "$1" | head -c 16384 ;;
      esac
    else printf "absent\n"; fi
  ' sh "$state/$1" "$2" "$3" 2>/dev/null || printf 'unavailable\n'
}

crash() {
  pid=$(read_state weston.pid head 32)
  case "$pid" in ''|*[!0-9]*) printf 'E5T18D_HOOK_ERROR=no-compositor\n'; return ;; esac
  # A user-writable PID file is only a hint. Bind the signal to the actual desktop Weston ELF.
  if [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" != /usr/bin/weston ] ||
     [ "$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)" != 1000 ]; then
    printf 'E5T18D_HOOK_ERROR=pid-identity\n'
    return
  fi
  # Even PID reuse between inspection and signaling cannot cross the desktop UID boundary.
  if runuser -u desktop -- /bin/kill -KILL "$pid"; then
    printf 'E5T18D_HOOK_CRASH pid=%s signal=KILL\n' "$pid"
  else
    printf 'E5T18D_HOOK_ERROR=signal-failed\n'
  fi
}

stty -echo 2>/dev/null || true
printf '\nE5T18D_TEST_CONSOLE_READY\n'
while IFS= read -r command; do
  command=$(printf '%s' "$command" | tr -d '\r')
  case "$command" in
    status)
      printf 'E5T18D_STATUS_BEGIN\n'
      for name in desktop.attempts desktop.ready desktop.failed weston.pid; do
        printf '%s=' "$name"
        read_state "$name" head 128
      done
      read_state desktop.log tail 80
      printf 'E5T18D_STATUS_END\n'
      ;;
    crash) crash ;;
    config-fail)
      # Only the opt-in disposable guest overlay is changed; the immutable image stays intact.
      if [ -f /etc/xdg/weston/weston.ini ]; then
        mv /etc/xdg/weston/weston.ini /etc/xdg/weston/weston.ini.disabled
      fi
      printf 'E5T18D_HOOK_CONFIG=missing\n'
      crash
      ;;
    log)
      printf 'E5T18D_LOG_BEGIN\n'
      read_state weston.log tail 100
      printf 'E5T18D_LOG_END\n'
      ;;
    tty)
      printf 'E5T18D_TTY_BEGIN\n'
      cat /sys/class/tty/tty0/active 2>/dev/null || true
      for getty_pid in $(pidof getty 2>/dev/null); do
        printf 'getty pid=%s args=' "$getty_pid"
        tr '\0' ' ' <"/proc/$getty_pid/cmdline" 2>/dev/null || true
        printf '\n'
      done
      head -c 16000 /dev/vcs1 2>/dev/null || true
      printf '\nE5T18D_TTY_END\n'
      ;;
    *) printf 'E5T18D_HOOK_ERROR=unknown-command\n' ;;
  esac
done
